# Normalize line endings

* text=auto

# Python

*.py text eol=lf
*.pyi text eol=lf

# Configuration / documentation

*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts

*.sh text eol=lf

# Windows scripts

*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.pdf binary
